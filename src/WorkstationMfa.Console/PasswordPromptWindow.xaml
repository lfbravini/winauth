<Window x:Class="WorkstationMfa.Console.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm admin password"
        Height="180" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
  <StackPanel Margin="16">
    <TextBlock Text="Re-enter privacyIDEA admin password to continue:" TextWrapping="Wrap"/>
    <PasswordBox x:Name="PasswordBox" Margin="0,12,0,12"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" Click="Cancel_Click" Background="#6B7280"/>
      <Button Content="Continue" Click="Ok_Click" IsDefault="True"/>
    </StackPanel>
  </StackPanel>
</Window>
