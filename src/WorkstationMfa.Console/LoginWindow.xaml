<Window x:Class="WorkstationMfa.Console.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workstation MFA — Sign in"
        Height="420" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="Workstation MFA" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
    <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,8,0,16"
               Text="Sign in with a privacyIDEA admin account for the selected connection profile."/>

    <StackPanel Grid.Row="2">
      <TextBlock Text="Connection profile"/>
      <ComboBox x:Name="ProfileCombo" DisplayMemberPath="DisplayLabel" Height="28"/>
      <TextBlock x:Name="ProfileSourceText" Foreground="Gray" FontSize="11" Margin="0,4,0,0"/>
    </StackPanel>

    <StackPanel Grid.Row="3" Margin="0,12,0,0">
      <TextBlock Text="Admin username"/>
      <TextBox x:Name="UsernameBox"/>
      <TextBlock Text="Password" Margin="0,8,0,0"/>
      <PasswordBox x:Name="PasswordBox"/>
    </StackPanel>

    <TextBlock x:Name="ErrorText" Grid.Row="4" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,8,0,0"/>

    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Refresh profiles" Click="Refresh_Click" Background="#6B7280"/>
      <Button Content="Sign in" Click="SignIn_Click" IsDefault="True"/>
    </StackPanel>
  </Grid>
</Window>
